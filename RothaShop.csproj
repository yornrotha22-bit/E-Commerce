<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RothaShop</RootNamespace>
    <AssemblyName>RothaShop</AssemblyName>
    <UserSecretsId>rothashop-ecommerce</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Kh.Gov.Nbc.BakongKHQR" Version="1.0.0.17" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <!-- Overrides the vulnerable transitive version pulled in by the EF Core design tooling (patched in 10.0.13). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test sources live in tests/; keep them out of the web app build and publish output. -->
    <Compile Remove="tests/**" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI dictionaries (en/km) are read at runtime by TranslationStore.
         They are already Content items by default; just make sure they are copied. -->
    <Content Update="Localization\Strings\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
