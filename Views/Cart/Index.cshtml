@model CartViewModel
@{
    ViewData["Title"] = T["cartPage.title"];
    var messageType = TempData["CartMessageType"] as string ?? "success";
    var placeholder = Url.Content("~/images/placeholder-product.svg");
}

<div class="container storefront py-4">
    <h1 class="h3 mb-1">@T["cartPage.title"]</h1>
    <p class="text-muted small mb-4">
        @T["cartPage.note"]
    </p>

    @if (TempData["CartMessage"] is string message)
    {
        <div class="alert alert-@messageType alert-dismissible fade show" role="alert">
            @message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@T["common.close"]"></button>
        </div>
    }

    @if (Model.IsEmpty)
    {
        <div class="empty-state">
            <h2 class="h5">@T["cart.empty"]</h2>
            <p class="text-muted mb-3">@T["cartPage.emptyHint"]</p>
            <a class="btn btn-primary" asp-controller="Products" asp-action="Index">@T["common.continueShopping"]</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card cart-card">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>@T["cartPage.product"]</th>
                                    <th class="text-end">@T["cartPage.price"]</th>
                                    <th>@T["details.quantity"]</th>
                                    <th class="text-end">@T["cartPage.total"]</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    var image = string.IsNullOrWhiteSpace(item.ImageUrl) ? placeholder : item.ImageUrl;

                                    <tr class="@(item.IsAvailable ? string.Empty : "table-warning")">
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@image" alt="@item.ProductName" class="cart-thumb" />
                                                <div>
                                                    <a class="fw-semibold"
                                                       asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId">
                                                        @item.ProductName
                                                    </a>
                                                    <div class="small text-muted">@item.VariantLabel</div>
                                                    @if (!item.IsAvailable)
                                                    {
                                                        <div class="small text-danger">@item.UnavailableReason</div>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-end text-nowrap">$@item.UnitPrice.ToString("N2")</td>
                                        <td>
                                            @if (item.IsAvailable)
                                            {
                                                <form asp-controller="Cart" asp-action="Update" method="post"
                                                      class="d-flex gap-1">
                                                    <input type="hidden" name="cartItemId" value="@item.Id" />
                                                    <label class="visually-hidden" for="qty-@item.Id">@T["details.quantity"]</label>
                                                    <input id="qty-@item.Id" type="number" name="quantity"
                                                           value="@item.Quantity" min="1"
                                                           max="@Math.Max(item.StockQuantity, 1)"
                                                           class="form-control form-control-sm cart-quantity" />
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary">@T["cartPage.update"]</button>
                                                </form>
                                                @if (item.StockQuantity <= 5)
                                                {
                                                    <div class="small text-muted mt-1">@T.Format("cartPage.left", item.StockQuantity)</div>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="text-end text-nowrap fw-semibold">$@item.LineTotal.ToString("N2")</td>
                                        <td class="text-end">
                                            <form asp-controller="Cart" asp-action="Remove" method="post">
                                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                                        aria-label="@T.Format("cart.removeAria", item.ProductName)">@T["cart.remove"]</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-between gap-2 mt-3">
                    <a class="btn btn-outline-secondary" asp-controller="Products" asp-action="Index">
                        @T["common.continueShopping"]
                    </a>

                    <form asp-controller="Cart" asp-action="Clear" method="post"
                          onsubmit="return confirm('@T["cartPage.clearConfirm"]');">
                        <button type="submit" class="btn btn-outline-danger">@T["cartPage.clear"]</button>
                    </form>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card cart-summary">
                    <div class="card-body">
                        <h2 class="h6 mb-3">@T["checkout.summary"]</h2>

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">@T["cart.subtotal"]</span>
                            <span>$@Model.Subtotal.ToString("N2")</span>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">@T["cart.shipping"]</span>
                            <span>
                                @if (Model.ShippingFee == 0 && Model.Subtotal > 0)
                                {
                                    <span class="text-success">@T["cart.free"]</span>
                                }
                                else
                                {
                                    <span>$@Model.ShippingFee.ToString("N2")</span>
                                }
                            </span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between fw-bold fs-5">
                            <span>@T["cartPage.total"]</span>
                            <span>$@Model.Total.ToString("N2")</span>
                        </div>

                        @if (Model.Subtotal > 0 && !Model.QualifiesForFreeShipping)
                        {
                            <p class="small text-muted mt-2 mb-0">
                                @T.Format("cartPage.moreForFree", Model.AmountToFreeShipping.ToString("N2"))
                            </p>
                        }

                        @if (Model.HasUnavailableItems)
                        {
                            <div class="alert alert-warning small mt-3 mb-0" role="alert">
                                @T["cartPage.unavailable"]
                            </div>
                        }

                        <div class="mt-3">
                            @if (Model.CanCheckout)
                            {
                                <a class="btn btn-primary w-100" asp-controller="Checkout" asp-action="Index">
                                    @T["cart.checkout"]
                                </a>
                            }
                            else
                            {
                                <button type="button" class="btn btn-primary w-100" disabled>@T["cart.checkout"]</button>
                            }
                        </div>

                        <p class="small text-muted mt-3 mb-0">
                            @(Model.ItemCount == 1
                                ? T.Format("cartPage.itemsOne", Model.ItemCount)
                                : T.Format("cartPage.items", Model.ItemCount))
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
