@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5 text-center">
                    <p class="display-4 fw-bold text-primary mb-1">@Model.StatusCode</p>
                    <h1 class="h4 mb-3">@Model.Title</h1>
                    <p class="text-muted">@Model.Message</p>

                    @if (Model.ShowRequestId)
                    {
                        <p class="small text-muted mb-3">
                            @T["error.requestId"]: <code>@Model.RequestId</code>
                        </p>
                    }

                    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">@T["account.backToHome"]</a>
                </div>
            </div>
        </div>
    </div>
</div>
