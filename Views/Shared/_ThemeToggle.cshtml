@{
    var switchToDark = T["common.darkMode"];
    var switchToLight = T["common.lightMode"];
}

<button type="button" class="rs-icon-btn rs-theme-toggle" data-theme-toggle
        data-label-dark="@switchToDark" data-label-light="@switchToLight"
        aria-label="@switchToDark" aria-pressed="false" title="@switchToDark">
    <svg class="rs-theme-toggle__icon rs-theme-toggle__icon--moon" width="20" height="20"
         viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8.2 8.2 0 1 0 10.5 10.5Z" fill="none"
              stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
    </svg>
    <svg class="rs-theme-toggle__icon rs-theme-toggle__icon--sun" width="20" height="20"
         viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6" />
        <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"
              fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
</button>
