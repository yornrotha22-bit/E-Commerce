<!DOCTYPE html>
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    // Same rule as the storefront: a dropped-in PNG wins over the bundled mark.
    var adminLogoPath = System.IO.File.Exists(System.IO.Path.Combine(Env.WebRootPath, "images", "kshop-logo.png"))
        ? "~/images/kshop-logo.png"
        : "~/images/kshop-logo-compact.svg";
}
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="@Url.Content("~/favicon.svg")" />
    <title>@ViewData["Title"] · KStore Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Sans+Khmer:wght@400;500;600&display=swap" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-body" data-dismiss-label="@T["common.dismiss"]">
    @{
        var active = ViewData["Active"] as string;
        string ActiveClass(string name) => active == name ? "admin-nav__link active" : "admin-nav__link";
        var displayName = User.Identity?.Name ?? "Admin";
        var roleLabel = User.IsInRole(Roles.SuperAdmin)
            ? Roles.SuperAdmin
            : User.IsInRole(Roles.Admin) ? Roles.Admin : Roles.Staff;
        var canManageCatalog = User.IsInRole(Roles.SuperAdmin) || User.IsInRole(Roles.Admin);
    }

    <div class="admin-shell" id="adminShell">
        <aside class="admin-sidebar" id="adminSidebar" aria-label="@T["admin.nav.dashboard"]">
            <div class="admin-sidebar__head">
                <a class="admin-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <img class="admin-brand__logo" src="@Url.Content(adminLogoPath)" alt="KStore" />
                </a>
                <button type="button" class="admin-icon-btn admin-sidebar__close d-lg-none"
                        data-admin-close aria-label="@T["admin.closeNavigation"]">
                    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor"
                              stroke-width="1.7" stroke-linecap="round" />
                    </svg>
                </button>
            </div>

            <nav class="admin-nav">
                <a class="@ActiveClass("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                   title="@T["admin.nav.dashboard"]">
                    <svg class="admin-nav__icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="4" y="4" width="7" height="7" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.6" />
                        <rect x="13" y="4" width="7" height="7" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.6" />
                        <rect x="4" y="13" width="7" height="7" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.6" />
                        <rect x="13" y="13" width="7" height="7" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.6" />
                    </svg>
                    <span class="admin-nav__label">@T["admin.nav.dashboard"]</span>
                </a>

                <div class="admin-nav__heading">@T["admin.nav.catalog"]</div>
                <a class="@ActiveClass("Products")" asp-area="Admin" asp-controller="Products" asp-action="Index" title="@T["admin.nav.products"]">
                    <svg class="admin-nav__icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 3.5 20 7v10l-8 3.5L4 17V7l8-3.5Z" fill="none" stroke="currentColor"
                              stroke-width="1.6" stroke-linejoin="round" />
                        <path d="M4 7l8 3.5L20 7M12 10.5V20.5" fill="none" stroke="currentColor" stroke-width="1.4" />
                    </svg>
                    <span class="admin-nav__label">@T["admin.nav.products"]</span>
                </a>
                <a class="@ActiveClass("Categories")" asp-area="Admin" asp-controller="Categories" asp-action="Index" title="@T["admin.nav.categories"]">
                    <svg class="admin-nav__icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="4" y="4" width="16" height="5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6" />
                        <rect x="4" y="12" width="16" height="8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6" />
                    </svg>
                    <span class="admin-nav__label">@T["admin.nav.categories"]</span>
                </a>
                <a class="@ActiveClass("Brands")" asp-area="Admin" asp-controller="Brands" asp-action="Index" title="@T["admin.nav.brands"]">
                    <svg class="admin-nav__icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 11.5V5.5A1.5 1.5 0 0 1 5.5 4h6l8 8-6.5 6.5-8-8Z" fill="none"
                              stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                        <circle cx="8.5" cy="8.5" r="1.3" fill="currentColor" />
                    </svg>
                    <span class="admin-nav__label">@T["admin.nav.brands"]</span>
                </a>
                <a class="@ActiveClass("Reviews")" asp-area="Admin" asp-controller="Reviews" asp-action="Index" title="@T["admin.nav.reviews"]">
                    <svg class="admin-nav__icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="m12 4 2.4 5 5.6.7-4.1 3.8 1.1 5.5L12 16.6 7 19l1.1-5.5L4 9.7 9.6 9 12 4Z"
                              fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                    </svg>
                    <span class="admin-nav__label">@T["admin.nav.reviews"]</span>
                </a>

                <div class="admin-nav__heading">@T["admin.nav.sales"]</div>
                <a class="@ActiveClass("Orders")" asp-area="Admin" asp-controller="Orders" asp-action="Index" title="@T["admin.nav.orders"]">
                    <svg class="admin-nav__icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 4h12v16l-3-2-3 2-3-2-3 2V4Z" fill="none" stroke="currentColor"
                              stroke-width="1.6" stroke-linejoin="round" />
                        <path d="M9 9h6M9 13h6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                    </svg>
                    <span class="admin-nav__label">@T["admin.nav.orders"]</span>
                    @await Component.InvokeAsync("PendingOrders")
                </a>
                <a class="@ActiveClass("Payments")" asp-area="Admin" asp-controller="Payments" asp-action="Index" title="@T["admin.nav.payments"]">
                    <svg class="admin-nav__icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="3.5" y="6" width="17" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" />
                        <path d="M3.5 10h17" fill="none" stroke="currentColor" stroke-width="1.6" />
                    </svg>
                    <span class="admin-nav__label">@T["admin.nav.payments"]</span>
                </a>
                <a class="@ActiveClass("Promotions")" asp-area="Admin" asp-controller="Promotions" asp-action="Index" title="@T["admin.nav.promotions"]">
                    <svg class="admin-nav__icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 18 18 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                        <circle cx="8" cy="8" r="2" fill="none" stroke="currentColor" stroke-width="1.5" />
                        <circle cx="16" cy="16" r="2" fill="none" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                    <span class="admin-nav__label">@T["admin.nav.promotions"]</span>
                </a>

                <div class="admin-nav__heading">@T["admin.nav.people"]</div>
                <a class="@ActiveClass("Customers")" asp-area="Admin" asp-controller="Customers" asp-action="Index" title="@T["admin.nav.customers"]">
                    <svg class="admin-nav__icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="9.5" cy="9" r="3" fill="none" stroke="currentColor" stroke-width="1.6" />
                        <path d="M4 19c.8-3 2.9-4.6 5.5-4.6S14.2 16 15 19" fill="none" stroke="currentColor"
                              stroke-width="1.6" stroke-linecap="round" />
                        <path d="M16 8.2a2.6 2.6 0 0 1 0 5M17.5 14.7c1.6.5 2.7 1.9 3 4.3" fill="none"
                              stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                    <span class="admin-nav__label">@T["admin.nav.customers"]</span>
                </a>
                @if (User.IsInRole(Roles.SuperAdmin))
                {
                    <a class="@ActiveClass("Users")" asp-area="Admin" asp-controller="Users" asp-action="Index" title="@T["admin.nav.users"]">
                        <svg class="admin-nav__icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 3.5 19 6v5.5c0 4.2-2.9 7.4-7 8.5-4.1-1.1-7-4.3-7-8.5V6l7-2.5Z"
                                  fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                        </svg>
                        <span class="admin-nav__label">@T["admin.nav.users"]</span>
                    </a>
                }

                <div class="admin-nav__heading">@T["admin.nav.insights"]</div>
                <a class="@ActiveClass("Reports")" asp-area="Admin" asp-controller="Reports" asp-action="Index" title="@T["admin.nav.reports"]">
                    <svg class="admin-nav__icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 19h16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                        <path d="M7 19v-6M12 19V7M17 19v-9" fill="none" stroke="currentColor"
                              stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                    <span class="admin-nav__label">@T["admin.nav.reports"]</span>
                </a>
            </nav>

            <div class="admin-sidebar__footer">
                <a asp-area="" asp-controller="Home" asp-action="Index" title="@T["admin.viewStore"]">
                    <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M14 5h5v5M19 5l-8 8M9 5H5v14h14v-4" fill="none" stroke="currentColor"
                              stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span>@T["admin.viewStore"]</span>
                </a>
                <span class="admin-sidebar__role">@T.Format("admin.workspace", roleLabel)</span>
            </div>
        </aside>

        <div class="admin-backdrop" data-admin-close aria-hidden="true"></div>

        <div class="admin-main">
            <header class="admin-topbar">
                <button type="button" class="admin-icon-btn" id="adminNavToggle"
                        data-admin-toggle aria-controls="adminSidebar" aria-label="@T["admin.toggleNavigation"]">
                    <svg width="19" height="19" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor"
                              stroke-width="1.7" stroke-linecap="round" />
                    </svg>
                </button>

                <div class="admin-topbar__title">
                    <h1>@ViewData["Title"]</h1>
                </div>

                <div class="admin-topbar__actions">
                    <partial name="_LanguageSwitcher" />

                    <a class="admin-icon-btn d-none d-sm-inline-flex" asp-area="" asp-controller="Home"
                       asp-action="Index" title="@T["admin.viewStore"]" aria-label="@T["admin.viewStore"]">
                        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M14 5h5v5M19 5l-8 8M9 5H5v14h14v-4" fill="none" stroke="currentColor"
                                  stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </a>

                    <div class="dropdown">
                        <button class="admin-user" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="admin-user__avatar" aria-hidden="true">@await Component.InvokeAsync("UserAvatar")</span>
                            <span class="admin-user__meta d-none d-md-flex">
                                <span class="admin-user__name">@displayName</span>
                                <span class="admin-user__role">@roleLabel</span>
                            </span>
                            <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="m7 10 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8"
                                      stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end rs-menu">
                            <li class="rs-menu__head">
                                <span class="rs-menu__name">@displayName</span>
                                <span class="rs-menu__hint">@roleLabel</span>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile">
                                    @T["common.profile"]
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index">
                                    @T["admin.storefront"]
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item">@T["common.signOut"]</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <div class="admin-content">
                <div class="admin-container">
                    @if (TempData["Success"] is string success)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @success
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@T["common.close"]"></button>
                        </div>
                    }

                    @if (TempData["Error"] is string error)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @error
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@T["common.close"]"></button>
                        </div>
                    }

                    @RenderBody()
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            crossorigin="anonymous"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
