@model CouponFormViewModel

<input type="hidden" asp-for="Id" />

<div asp-validation-summary="ModelOnly" class="col-12 text-danger small"></div>

@if (Model.UsedCount > 0)
{
    <div class="col-12">
        <div class="alert alert-info py-2 small mb-0">
            @T.Format("adm.couponUsed", Model.UsedCount)
        </div>
    </div>
}

<div class="col-md-6">
    <label asp-for="Code" class="form-label">@T["adm.code"]</label>
    <input asp-for="Code" class="form-control text-uppercase" autocomplete="off" />
    <div class="form-text">@T["adm.codeHint"]</div>
    <span asp-validation-for="Code" class="text-danger small"></span>
</div>

<div class="col-md-6">
    <label asp-for="DiscountType" class="form-label">@T["adm.discountType"]</label>
    <select asp-for="DiscountType" class="form-select">
        <option value="@DiscountType.Percentage">@T["adm.percentage"]</option>
        <option value="@DiscountType.FixedAmount">@T["adm.fixedAmount"]</option>
    </select>
    <span asp-validation-for="DiscountType" class="text-danger small"></span>
</div>

<div class="col-md-6">
    <label asp-for="DiscountValue" class="form-label">@T["adm.discountValue"]</label>
    <input asp-for="DiscountValue" class="form-control" type="number" step="0.01" min="0.01" />
    <div class="form-text">@T["adm.discountValueHint"]</div>
    <span asp-validation-for="DiscountValue" class="text-danger small"></span>
</div>

<div class="col-md-6">
    <label asp-for="MinimumOrderAmount" class="form-label">@T["adm.minOrder"]</label>
    <input asp-for="MinimumOrderAmount" class="form-control" type="number" step="0.01" min="0" />
    <span asp-validation-for="MinimumOrderAmount" class="text-danger small"></span>
</div>

<div class="col-md-6">
    <label asp-for="MaxDiscountAmount" class="form-label">@T["adm.maxDiscount"]</label>
    <input asp-for="MaxDiscountAmount" class="form-control" type="number" step="0.01" min="0.01" />
    <div class="form-text">@T["adm.maxDiscountHint"]</div>
    <span asp-validation-for="MaxDiscountAmount" class="text-danger small"></span>
</div>

<div class="col-md-6">
    <label asp-for="UsageLimit" class="form-label">@T["adm.usageLimit"]</label>
    <input asp-for="UsageLimit" class="form-control" type="number" min="1" />
    <div class="form-text">@T["adm.usageLimitHint"]</div>
    <span asp-validation-for="UsageLimit" class="text-danger small"></span>
</div>

<div class="col-md-3">
    <label asp-for="StartsAt" class="form-label">@T["adm.startsAt"]</label>
    <input asp-for="StartsAt" class="form-control" type="date" />
    <span asp-validation-for="StartsAt" class="text-danger small"></span>
</div>

<div class="col-md-3">
    <label asp-for="EndsAt" class="form-label">@T["adm.endsAt"]</label>
    <input asp-for="EndsAt" class="form-control" type="date" />
    <span asp-validation-for="EndsAt" class="text-danger small"></span>
</div>

<div class="col-12">
    <label asp-for="Description" class="form-label">@T["details.description"]</label>
    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
    <span asp-validation-for="Description" class="text-danger small"></span>
</div>

<div class="col-12">
    <div class="form-check">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label">@T["adm.active"]</label>
    </div>
</div>
