@model BrandFormViewModel

<div asp-validation-summary="ModelOnly" class="col-12 text-danger small"></div>

<div class="col-md-6">
    <label asp-for="Name" class="form-label">@T["adm.name"]</label>
    <input asp-for="Name" class="form-control" autocomplete="off" />
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>

<div class="col-md-6">
    <label asp-for="Slug" class="form-label">@T["adm.slug"]</label>
    <input asp-for="Slug" class="form-control" placeholder="@T["adm.slugHint"]" />
    <span asp-validation-for="Slug" class="text-danger small"></span>
</div>

<div class="col-md-6">
    <label asp-for="LogoFile" class="form-label">@T["adm.logoUpload"]</label>
    <input asp-for="LogoFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" data-brand-logo-upload />
    <div class="form-text">@T["adm.logoUploadHint"]</div>
    <span asp-validation-for="LogoFile" class="text-danger small"></span>
    @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
    {
        <div class="d-flex align-items-center gap-3 mt-2">
            <img src="@Model.LogoUrl" alt="@T["adm.currentLogo"]" data-brand-logo-preview style="max-width: 120px; max-height: 80px; object-fit: contain;" />
            <div class="form-check">
                <input asp-for="RemoveLogo" class="form-check-input" />
                <label asp-for="RemoveLogo" class="form-check-label">@T["adm.removeLogo"]</label>
            </div>
        </div>
    }
    else
    {
        <img alt="@T["adm.currentLogo"]" data-brand-logo-preview class="d-none mt-2" style="max-width: 120px; max-height: 80px; object-fit: contain;" />
    }
</div>

<div class="col-md-6 d-flex align-items-end">
    <div class="form-check mb-2">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label">@T["adm.active"]</label>
        <div class="form-text">@T["adm.inactiveBrandNote"]</div>
    </div>
</div>

<div class="col-12">
    <label asp-for="Description" class="form-label">@T["details.description"]</label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Description" class="text-danger small"></span>
</div>

<script>
    (() => {
        const input = document.querySelector('[data-brand-logo-upload]');
        const preview = document.querySelector('[data-brand-logo-preview]');
        if (!input || !preview) return;
        input.addEventListener('change', () => {
            const file = input.files && input.files[0];
            if (!file) return;
            preview.src = URL.createObjectURL(file);
            preview.classList.remove('d-none');
        });
    })();
</script>
