@model BrandFormViewModel
@{
    ViewData["Title"] = T["adm.editBrand"];
}

<div class="card admin-card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="row g-3">
            <input type="hidden" asp-for="Id" />
            <partial name="_Form" model="Model" />

            <div class="col-12 d-flex gap-2 pt-2">
                <button type="submit" class="btn btn-primary">@T["account.saveChanges"]</button>
                <a class="btn btn-outline-secondary" asp-action="Index">@T["account.cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
