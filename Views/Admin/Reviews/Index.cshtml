@model PagedList<AdminReviewRow>
@{
    ViewData["Title"] = T["admin.nav.reviews"];
    var status = ViewData["Status"] as string ?? "pending";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div class="btn-group" role="group" aria-label="@T["adm.reviewFilters"]">
        <a class="btn btn-sm @(status == "pending" ? "btn-primary" : "btn-outline-secondary")"
           asp-action="Index" asp-route-status="pending">@T["adm.pending"]</a>
        <a class="btn btn-sm @(status == "approved" ? "btn-primary" : "btn-outline-secondary")"
           asp-action="Index" asp-route-status="approved">@T["adm.approved"]</a>
        <a class="btn btn-sm @(status == "all" ? "btn-primary" : "btn-outline-secondary")"
           asp-action="Index" asp-route-status="all">@T["adm.all"]</a>
    </div>

    <span class="small text-muted">@T.Format("adm.reviewCount", Model.TotalItems)</span>
</div>

<div class="card admin-card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>@T["cartPage.product"]</th>
                    <th>@T["dashboard.customer"]</th>
                    <th>@T["details.rating"]</th>
                    <th>@T["details.yourReview"]</th>
                    <th>@T["dashboard.status"]</th>
                    <th>@T["dashboard.date"]</th>
                    <th class="text-end">@T["dashboard.actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">@T["adm.noReviews"]</td>
                    </tr>
                }
                else
                {
                    @foreach (var review in Model.Items)
                    {
                        <tr>
                            <td>
                                <a class="fw-semibold" asp-area="" asp-controller="Products"
                                   asp-action="Details" asp-route-id="@review.ProductId">@review.ProductName</a>
                            </td>
                            <td>@review.CustomerName</td>
                            <td class="text-warning text-nowrap">
                                @for (var star = 1; star <= 5; star++)
                                {
                                    <span class="@(star <= review.Rating ? "text-warning" : "text-muted")">★</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(review.Title))
                                {
                                    <div class="fw-semibold">@review.Title</div>
                                }
                                <div class="small text-muted">@review.Comment</div>
                            </td>
                            <td>
                                @if (review.IsApproved)
                                {
                                    <span class="badge text-bg-success">@T["adm.approved"]</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-warning">@T["adm.pending"]</span>
                                }
                            </td>
                            <td class="small text-muted text-nowrap">@review.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end text-nowrap">
                                @if (!review.IsApproved)
                                {
                                    <form class="d-inline" asp-action="Approve" asp-route-id="@review.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-success">@T["adm.approve"]</button>
                                    </form>
                                }

                                <form class="d-inline" asp-action="Reject" asp-route-id="@review.Id" method="post"
                                      onsubmit="return confirm('@T["adm.confirmDeleteReview"]');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@T["adm.reject"]</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <partial name="~/Views/Admin/Shared/_TablePagination.cshtml" model="PaginationViewModel.From(Model)" />
</div>
