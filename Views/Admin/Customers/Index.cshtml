@model AdminCustomerListViewModel
@{
    ViewData["Title"] = T["admin.nav.customers"];
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <form method="get" class="d-flex gap-2">
        <input type="search" name="search" value="@Model.Search" class="form-control"
               placeholder="@T["adm.customerSearchPlaceholder"]" />
        <button type="submit" class="btn btn-outline-secondary">@T["common.search"]</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a class="btn btn-link" asp-action="Index">@T["products.clearAll"]</a>
        }
    </form>
</div>

<div class="card admin-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>@T["dashboard.customer"]</th>
                    <th>@T["adm.contact"]</th>
                    <th class="text-end">@T["admin.nav.orders"]</th>
                    <th class="text-end">@T["adm.paidTotal"]</th>
                    <th>@T["dashboard.status"]</th>
                    <th>@T["adm.joinedAt"]</th>
                    <th>@T["adm.lastOrderAt"]</th>
                    <th class="text-end">@T["dashboard.actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">@T["adm.noCustomers"]</td>
                    </tr>
                }
                else
                {
                    @foreach (var customer in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@customer.FullName</td>
                            <td>
                                <div>@customer.Email</div>
                                @if (!string.IsNullOrWhiteSpace(customer.PhoneNumber))
                                {
                                    <div class="small text-muted">@customer.PhoneNumber</div>
                                }
                            </td>
                            <td class="text-end">@customer.OrderCount</td>
                            <td class="text-end text-nowrap">$@customer.PaidTotal.ToString("N2")</td>
                            <td>
                                @if (customer.IsActive)
                                {
                                    <span class="badge text-bg-success">@T["adm.active"]</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">@T["adm.disabled"]</span>
                                }
                            </td>
                            <td class="small text-muted text-nowrap">@customer.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td class="small text-muted text-nowrap">
                                @(customer.LastOrderAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-action="Details" asp-route-id="@customer.Id">@T["adm.viewDetails"]</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <partial name="~/Views/Admin/Shared/_TablePagination.cshtml" model="PaginationViewModel.Create(Model.Page, Model.PageSize, Model.TotalItems)" />
</div>
