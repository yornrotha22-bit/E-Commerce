@model AdminCustomerDetailsViewModel
@{
    var customer = Model.Customer;
    ViewData["Title"] = T["adm.customerDetails"];

    string StatusBadge(OrderStatus value) => value switch
    {
        OrderStatus.Pending => "text-bg-warning",
        OrderStatus.Confirmed => "text-bg-info",
        OrderStatus.Processing => "text-bg-info",
        OrderStatus.Shipped => "text-bg-primary",
        OrderStatus.Delivered => "text-bg-success",
        OrderStatus.Cancelled => "text-bg-secondary",
        _ => "text-bg-secondary"
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h2 class="h4 mb-1">@customer.FullName</h2>
        <p class="text-muted small mb-0">
            @customer.Email
            @if (!string.IsNullOrWhiteSpace(customer.PhoneNumber))
            {
                <span>· @customer.PhoneNumber</span>
            }
        </p>
        <p class="text-muted small mb-0">
            @T.Format("adm.joinedLastLogin", customer.CreatedAt.ToString("yyyy-MM-dd"), customer.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? T["adm.never"])
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        @if (customer.IsActive)
        {
            <span class="badge text-bg-success">@T["adm.active"]</span>
        }
        else
        {
            <span class="badge text-bg-secondary">@T["adm.disabled"]</span>
        }

        <form asp-action="ToggleActive" asp-route-id="@customer.Id" method="post"
              onsubmit="return confirm('@T["adm.confirmToggleCustomer"]');">
            <button type="submit" class="btn btn-sm @(customer.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                @(customer.IsActive ? T["adm.deactivateAccount"] : T["adm.activateAccount"])
            </button>
        </form>

        <a class="btn btn-sm btn-outline-secondary" asp-action="Index">@T["adm.backToCustomers"]</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card admin-card h-100">
            <div class="card-header">@T.Format("adm.savedAddressesCount", Model.Addresses.Count)</div>
            <div class="card-body">
                @if (Model.Addresses.Count == 0)
                {
                    <p class="text-muted small mb-0">@T["adm.noSavedAddresses"]</p>
                }
                else
                {
                    @foreach (var address in Model.Addresses)
                    {
                        <div class="border-bottom pb-2 mb-2">
                            <div class="d-flex justify-content-between">
                                <span class="fw-semibold">@address.FullName</span>
                                @if (address.IsDefault)
                                {
                                    <span class="badge text-bg-primary">@T["account.defaultBadge"]</span>
                                }
                            </div>
                            <div class="small text-muted">@address.PhoneNumber</div>
                            <div class="small">
                                @address.AddressLine1, @address.City, @address.Country
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card admin-card h-100">
            <div class="card-header">@T.Format("adm.ordersCount", Model.Orders.Count)</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@T["dashboard.order"]</th>
                            <th>@T["adm.placedAt"]</th>
                            <th class="text-end">@T["dashboard.total"]</th>
                            <th>@T["dashboard.status"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Orders.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">@T["dashboard.noOrders"]</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var order in Model.Orders)
                            {
                                <tr>
                                    <td class="fw-semibold">@order.OrderNumber</td>
                                    <td class="small text-muted text-nowrap">@order.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="text-end text-nowrap">$@order.TotalAmount.ToString("N2")</td>
                                    <td>
                                        <span class="badge @StatusBadge(order.OrderStatus)">@T["status." + order.OrderStatus]</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
