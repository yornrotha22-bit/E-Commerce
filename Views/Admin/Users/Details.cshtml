@using System.Security.Claims
@model AdminUserDetailsViewModel
@{
    ViewData["Title"] = T["adm.userDetails"];

    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isSelf = string.Equals(currentUserId, Model.Id, StringComparison.Ordinal);

    string RoleBadgeClass(string role) => role switch
    {
        "SuperAdmin" => "text-bg-danger",
        "Admin" => "text-bg-warning",
        "Staff" => "text-bg-info",
        _ => "text-bg-secondary"
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h2 class="h4 mb-1">
            @Model.FullName
            @if (isSelf)
            {
                <span class="badge text-bg-primary align-middle">@T["adm.you"]</span>
            }
        </h2>
        <p class="text-muted small mb-0">@Model.Email</p>
        <p class="text-muted small mb-0">
            @(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? T["adm.noPhone"] : Model.PhoneNumber) ·
            @T.Format("adm.joinedLastLogin", Model.CreatedAt.ToString("yyyy-MM-dd"), Model.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? T["adm.never"])
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        @if (Model.IsActive)
        {
            <span class="badge text-bg-success">@T["adm.active"]</span>
        }
        else
        {
            <span class="badge text-bg-secondary">@T["adm.disabled"]</span>
        }

        @if (Model.IsLockedOut)
        {
            <span class="badge text-bg-danger">
                @T.Format("adm.lockedUntil", Model.LockoutEnd?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")
            </span>
        }

        <a class="btn btn-sm btn-outline-secondary" asp-action="Index">@T["adm.backToUsers"]</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card admin-card mb-3">
            <div class="card-header">@T["adm.roles"]</div>
            <div class="card-body">
                <form method="post" asp-action="UpdateRoles" asp-route-id="@Model.Id" novalidate>
                    <div class="mb-2">
                        @foreach (var role in Model.AllRoles)
                        {
                            var isChecked = Model.Roles.Contains(role, StringComparer.Ordinal);
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="roles" value="@role"
                                       id="role-@role" checked="@isChecked" />
                                <label class="form-check-label" for="role-@role">
                                    <span class="badge @RoleBadgeClass(role)">@role</span>
                                </label>
                            </div>
                        }
                    </div>
                    <p class="form-text">
                        @T["adm.rolesHint"]
                    </p>
                    <button type="submit" class="btn btn-primary btn-sm">@T["adm.saveRoles"]</button>
                </form>
            </div>
        </div>

        <div class="card admin-card">
            <div class="card-header">@T["adm.resetPassword"]</div>
            <div class="card-body">
                @if (isSelf)
                {
                    <p class="small text-muted mb-0">
                        @T["adm.selfPasswordHint"]
                        <a asp-area="" asp-controller="Account" asp-action="ChangePassword">@T["account.changePassword"]</a>
                    </p>
                }
                else
                {
                    <form method="post" asp-action="ResetPassword" novalidate>
                        <input type="hidden" name="UserId" value="@Model.ResetPassword.UserId" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="NewPassword">New password</label>
                                <input class="form-control" type="password" id="NewPassword" name="NewPassword"
                                       autocomplete="new-password" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="ConfirmPassword">@T["adm.confirmNewPassword"]</label>
                                <input class="form-control" type="password" id="ConfirmPassword" name="ConfirmPassword"
                                       autocomplete="new-password" required />
                            </div>
                        </div>

                        <p class="form-text">
                            @T["adm.resetPasswordHint"]
                        </p>

                        <button type="submit" class="btn btn-outline-primary btn-sm"
                                onclick="return confirm('@T["adm.confirmResetPassword"]');">
                            @T["adm.resetPassword"]
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card admin-card mb-3">
            <div class="card-header">@T["adm.accountState"]</div>
            <div class="card-body">
                <dl class="row small mb-3">
                    <dt class="col-6">@T["adm.emailConfirmed"]</dt>
                    <dd class="col-6">@(Model.EmailConfirmed ? T["adm.yes"] : T["adm.no"])</dd>
                    <dt class="col-6">@T["adm.ordersPlaced"]</dt>
                    <dd class="col-6">@Model.OrderCount</dd>
                </dl>

                <div class="d-flex flex-wrap gap-2">
                    <form method="post" asp-action="ToggleActive" asp-route-id="@Model.Id"
                          onsubmit="return confirm('@T["adm.confirmToggleUser"]');">
                        <button type="submit"
                                class="btn btn-sm @(Model.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                disabled="@isSelf">
                            @(Model.IsActive ? T["adm.deactivateAccount"] : T["adm.activateAccount"])
                        </button>
                    </form>

                    <form method="post" asp-action="Unlock" asp-route-id="@Model.Id">
                        <button type="submit" class="btn btn-sm btn-outline-warning" disabled="@(!Model.IsLockedOut)">
                            @T["adm.unlockAccount"]
                        </button>
                    </form>
                </div>

                @if (isSelf)
                {
                    <p class="form-text mb-0">@T["adm.selfDeactivateHint"]</p>
                }
            </div>
        </div>

        <div class="card admin-card">
            <div class="card-header">@T["adm.currentRoles"]</div>
            <div class="card-body">
                @if (Model.Roles.Count == 0)
                {
                    <p class="small text-muted mb-0">@T["adm.noRoles"]</p>
                }
                else
                {
                    @foreach (var role in Model.Roles)
                    {
                        <span class="badge @RoleBadgeClass(role) me-1">@role</span>
                    }
                }
            </div>
        </div>
    </div>
</div>
