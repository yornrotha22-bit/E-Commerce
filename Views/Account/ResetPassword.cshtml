@model ResetPasswordViewModel
@{
    ViewData["Title"] = T["account.newPasswordTitle"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h4 mb-1">@T["account.newPasswordTitle"]</h1>
                    <p class="text-muted small mb-4">@Model.Email</p>

                    <form asp-action="ResetPassword" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="Token" />

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label">@T["account.newPassword"]</label>
                            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">@T["account.confirmPassword"]</label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <p class="form-text mb-4">
                            @T["account.passwordRules"]
                        </p>

                        <button type="submit" class="btn btn-primary w-100">@T["account.saveNewPassword"]</button>
                    </form>
                </div>
            </div>

            <p class="text-center text-muted small mt-3 mb-0">
                <a asp-action="Login">@T["account.backToSignIn"]</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
