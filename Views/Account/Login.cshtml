@model LoginViewModel
@{
    ViewData["Title"] = T["account.signIn"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h4 mb-1">@T["account.signIn"]</h1>
                    <p class="text-muted small mb-4">@T["account.signInSubtitle"]</p>

                    <partial name="_AccountAlerts" />

                    @if (ViewData["GoogleLoginEnabled"] is true)
                    {
                        <form asp-action="ExternalLogin" method="post" class="mb-4">
                            <input type="hidden" name="provider" value="Google" />
                            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                            <button type="submit" class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-2">
                                <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
                                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5Z" transform="translate(0 4)" />
                                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.25 5.48-4.73 7.18l7.64 5.93c4.46-4.12 7.13-10.18 7.13-17.58Z" />
                                    <path fill="#FBBC05" d="M10.53 28.59A14.4 14.4 0 0 1 9.75 24c0-1.59.27-3.13.76-4.59l-7.98-6.2A23.9 23.9 0 0 0 0 24c0 3.87.93 7.53 2.56 10.78l7.97-6.19Z" transform="translate(0 0)" />
                                    <path fill="#34A853" d="M24 48c6.47 0 11.91-2.13 15.88-5.87l-7.64-5.93c-2.12 1.42-4.84 2.27-8.24 2.27-6.26 0-11.57-4.22-13.46-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48Z" />
                                </svg>
                                <span>@T["account.continueWithGoogle"]</span>
                            </button>
                        </form>
                        <div class="account-login-divider"><span>@T["account.or"]</span></div>
                    }

                    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">@T["account.email"]</label>
                            <input asp-for="Email" class="form-control" autocomplete="username" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">@T["common.password"]</label>
                            <input asp-for="Password" class="form-control" autocomplete="current-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="text-end mb-3">
                            <a class="small" asp-action="ForgotPassword">@T["account.forgotPassword"]</a>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">@T["account.rememberMe"]</label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">@T["account.signIn"]</button>
                    </form>
                </div>
            </div>

            <p class="text-center text-muted small mt-3 mb-0">
                @T["account.newHere"]
                <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]">@T["common.createAccount"]</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
