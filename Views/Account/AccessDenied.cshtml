@{
    ViewData["Title"] = T["account.accessDenied"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5 text-center">
                    <p class="display-6 fw-bold text-danger mb-2">403</p>
                    <h1 class="h4">@T["account.accessDenied"]</h1>
                    <p class="text-muted">
                        @T["account.accessDeniedText"]
                    </p>
                    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">@T["account.backToHome"]</a>
                </div>
            </div>
        </div>
    </div>
</div>
