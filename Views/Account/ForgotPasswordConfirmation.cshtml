@{
    ViewData["Title"] = T["account.checkEmail"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5 text-center">
                    <h1 class="h4 mb-3">@T["account.checkEmail"]</h1>
                    <p class="text-muted small mb-4">
                        @T["account.checkEmailText"]
                    </p>
                    <a class="btn btn-outline-secondary" asp-action="Login">@T["account.backToSignIn"]</a>
                </div>
            </div>
            <p class="text-center text-muted small mt-3 mb-0">
                @T["account.notReceived"]
                <a asp-action="ForgotPassword">@T["account.tryAgain"]</a>.
            </p>
        </div>
    </div>
</div>
