@model IReadOnlyList<Address>
@{
    ViewData["Title"] = T["account.addressesTitle"];
    ViewData["AccountTab"] = "Addresses";
}

<div class="container storefront py-4">
    <div class="row g-4">
        <aside class="col-lg-3">
            <partial name="_AccountNav" />
        </aside>

        <section class="col-lg-9">
            <partial name="_AccountAlerts" />

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div>
                    <h1 class="h4 mb-1">@T["account.addressesTitle"]</h1>
                    <p class="text-muted small mb-0">
                        @T["account.addressesSubtitle"]
                    </p>
                </div>
                <a class="btn btn-primary" asp-action="CreateAddress">@T["account.addAddress"]</a>
            </div>

            @if (Model.Count == 0)
            {
                <div class="empty-state">
                    <h2 class="h5">@T["account.noAddresses"]</h2>
                    <p class="text-muted mb-3">@T["account.noAddressesHint"]</p>
                    <a class="btn btn-primary" asp-action="CreateAddress">@T["account.addFirstAddress"]</a>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var address in Model)
                    {
                        <div class="col-md-6">
                            <div class="card address-card h-100">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                        <strong>@address.FullName</strong>
                                        @if (address.IsDefault)
                                        {
                                            <span class="badge text-bg-primary">@T["account.defaultBadge"]</span>
                                        }
                                    </div>

                                    <div class="small text-muted mb-2">@address.PhoneNumber</div>

                                    <address class="small mb-0">
                                        @address.AddressLine1
                                        @if (!string.IsNullOrWhiteSpace(address.AddressLine2))
                                        {
                                            <br />
                                            @address.AddressLine2
                                        }
                                        <br />
                                        @address.City@(string.IsNullOrWhiteSpace(address.State) ? string.Empty : ", " + address.State)
                                        @if (!string.IsNullOrWhiteSpace(address.PostalCode))
                                        {
                                            <text>, </text>@address.PostalCode
                                        }
                                        <br />
                                        @address.Country
                                    </address>
                                </div>

                                <div class="card-footer bg-white d-flex flex-wrap gap-2">
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-action="EditAddress" asp-route-id="@address.Id">@T["account.edit"]</a>

                                    @if (!address.IsDefault)
                                    {
                                        <form asp-action="SetDefaultAddress" asp-route-id="@address.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-primary">@T["account.setDefault"]</button>
                                        </form>
                                    }

                                    <form asp-action="DeleteAddress" asp-route-id="@address.Id" method="post"
                                          onsubmit="return confirm('@T["account.deleteConfirm"]');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">@T["account.delete"]</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    </div>
</div>
