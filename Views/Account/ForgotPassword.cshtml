@model ForgotPasswordViewModel
@{
    ViewData["Title"] = T["account.forgotTitle"];
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h4 mb-1">@T["account.forgotTitle"]</h1>
                    <p class="text-muted small mb-4">
                        @T["account.forgotSubtitle"]
                    </p>

                    <form asp-action="ForgotPassword" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label">@T["account.email"]</label>
                            <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">@T["account.sendResetLink"]</button>
                    </form>
                </div>
            </div>

            <p class="text-center text-muted small mt-3 mb-0">
                @T["account.remembered"]
                <a asp-action="Login">@T["account.backToSignIn"]</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
