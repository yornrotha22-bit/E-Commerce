@model ChangePasswordViewModel
@{
    ViewData["Title"] = T["account.changePassword"];
    ViewData["AccountTab"] = "Password";
}

<div class="container storefront py-4">
    <div class="row g-4">
        <aside class="col-lg-3">
            <partial name="_AccountNav" />
        </aside>

        <section class="col-lg-9">
            <partial name="_AccountAlerts" />

            <div class="card account-card">
                <div class="card-body p-4">
                    <h1 class="h4 mb-1">@T["account.changePassword"]</h1>
                    <p class="text-muted small mb-4">
                        @T["account.passwordRules"]
                    </p>

                    <form asp-action="ChangePassword" method="post" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                        <div class="col-md-6">
                            <label asp-for="CurrentPassword" class="form-label">@T["account.currentPassword"]</label>
                            <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-12"></div>

                        <div class="col-md-6">
                            <label asp-for="NewPassword" class="form-label">@T["account.newPassword"]</label>
                            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label">@T["account.confirmPassword"]</label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-12 pt-2">
                            <button type="submit" class="btn btn-primary">@T["account.updatePassword"]</button>
                            <a class="btn btn-outline-secondary" asp-action="Profile">@T["account.cancel"]</a>
                        </div>
                    </form>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
