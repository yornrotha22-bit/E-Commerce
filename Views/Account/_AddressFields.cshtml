@model AddressFormViewModel
<input type="hidden" asp-for="Id" />
<div asp-validation-summary="ModelOnly" class="col-12 text-danger small"></div>
<div class="col-md-6">
    <label asp-for="FullName" class="form-label">@T["account.fullName"]</label>
    <input asp-for="FullName" class="form-control" autocomplete="name" />
    <span asp-validation-for="FullName" class="text-danger small"></span>
</div>
<div class="col-md-6">
    <label asp-for="PhoneNumber" class="form-label">@T["account.phone"]</label>
    <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
</div>
<div class="col-12">
    <label asp-for="AddressLine1" class="form-label">@T["account.addressLine1"]</label>
    <input asp-for="AddressLine1" class="form-control" autocomplete="address-line1" />
    <span asp-validation-for="AddressLine1" class="text-danger small"></span>
</div>
<div class="col-12">
    <label asp-for="AddressLine2" class="form-label">@T["account.addressLine2"]</label>
    <input asp-for="AddressLine2" class="form-control" autocomplete="address-line2" />
    <span asp-validation-for="AddressLine2" class="text-danger small"></span>
</div>
<div class="col-md-6">
    <label asp-for="City" class="form-label">@T["account.city"]</label>
    <input asp-for="City" class="form-control" autocomplete="address-level2" />
    <span asp-validation-for="City" class="text-danger small"></span>
</div>
<div class="col-md-6">
    <label asp-for="State" class="form-label">@T["account.state"]</label>
    <input asp-for="State" class="form-control" autocomplete="address-level1" />
    <span asp-validation-for="State" class="text-danger small"></span>
</div>
<div class="col-md-6">
    <label asp-for="PostalCode" class="form-label">@T["account.postalCode"]</label>
    <input asp-for="PostalCode" class="form-control" autocomplete="postal-code" />
    <span asp-validation-for="PostalCode" class="text-danger small"></span>
</div>

<div class="col-md-6">
    <label asp-for="Country" class="form-label">@T["account.country"]</label>
    <input asp-for="Country" class="form-control" autocomplete="country-name" />
    <span asp-validation-for="Country" class="text-danger small"></span>
</div>

<div class="col-12">
    <div class="form-check">
        <input asp-for="IsDefault" class="form-check-input" />
        <label asp-for="IsDefault" class="form-check-label">@T["account.isDefault"]</label>
    </div>
</div>

<div class="col-12 pt-2">
    <button type="submit" class="btn btn-primary">@T["account.saveAddress"]</button>
    <a class="btn btn-outline-secondary" asp-action="Addresses">@T["account.cancel"]</a>
</div>
