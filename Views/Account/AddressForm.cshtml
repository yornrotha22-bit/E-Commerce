@model AddressFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? T["account.editAddress"] : T["account.addAddress"];
    ViewData["AccountTab"] = "Addresses";
}

<div class="container storefront py-4">
    <div class="row g-4">
        <aside class="col-lg-3">
            <partial name="_AccountNav" />
        </aside>

        <section class="col-lg-9">
            <partial name="_AccountAlerts" />

            <div class="card account-card">
                <div class="card-body p-4">
                    <h1 class="h4 mb-1">@(isEdit ? T["account.editAddress"] : T["account.addAddress"])</h1>
                    <p class="text-muted small mb-4">@T["account.addressHint"]</p>

                    @if (isEdit)
                    {
                        <form asp-action="EditAddress" asp-route-id="@Model.Id" method="post" class="row g-3">
                            <partial name="_AddressFields" model="Model" />
                        </form>
                    }
                    else
                    {
                        <form asp-action="CreateAddress" method="post" class="row g-3">
                            <partial name="_AddressFields" model="Model" />
                        </form>
                    }
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
